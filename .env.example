# Variáveis do Radar de Vendas. No Easypanel: serviço "radar" > Environment > cole tudo preenchido.

# Endereço público do painel (o domínio que o Easypanel gerar ou o seu)
APP_URL=
# Uma senha longa inventada por você. Protege o webhook do WhatsApp.
WEBHOOK_SECRET=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Modelo barato usado em quase tudo (o Sonnet acima só entra nas conversas quentes)
AI_MODEL_FAST=claude-haiku-5-5

# Google Places API (console.cloud.google.com)
GOOGLE_MAPS_API_KEY=

# Evolution API (o serviço do WhatsApp no Easypanel)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Transcrição de áudios (console.groq.com/keys)
GROQ_API_KEY=

# Asaas (Integrações > Chave de API). ASAAS_ENV=sandbox para testar sem dinheiro real.
ASAAS_API_KEY=
ASAAS_ENV=producao
# O mesmo token que você colocar no webhook do Asaas (campo "Token de autenticação")
ASAAS_WEBHOOK_TOKEN=

# Browserless (recibos em PDF). Nuvem: https://production-sfo.browserless.io
BROWSERLESS_URL=https://production-sfo.browserless.io
BROWSERLESS_TOKEN=

TZ=America/Sao_Paulo
