# Copie estas variáveis para o Easypanel (app → Ambiente). NUNCA coloque os valores reais no GitHub.

# Endereço público do sistema (com https, sem barra no fim)
APP_URL=https://mapadaalma.com.br
PORT=3000

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Segurança: texto longo e aleatório, só letras e números (o Easypanel corta valores com # e $)
WEBHOOK_SECRET=

# IA (console.anthropic.com → API Keys). Modelo opcional.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# WhatsApp — Evolution API instalada no MESMO projeto do Easypanel
EVOLUTION_API_URL=http://mapa-da-alma_evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=mapadaalma

# PDF — Browserless instalado no mesmo projeto do Easypanel
BROWSERLESS_URL=http://mapa-da-alma_browserless:3000
BROWSERLESS_TOKEN=

# Pix — Asaas (conta no seu CPF). Use ASAAS_ENV=sandbox para testar.
ASAAS_API_KEY=
ASAAS_ENV=production
ASAAS_WEBHOOK_TOKEN=
